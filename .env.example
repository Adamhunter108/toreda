# toreda configuration — copy to `.env` and fill in.
#
#   cp .env.example .env && chmod 600 .env
#
# Or just run `npm run setup`, which writes this file for you and verifies the
# keys against Alpaca before saving them.
#
# .env is gitignored. Never commit it, and never paste its contents anywhere.

# ─── Alpaca: paper trading (fake money — start here) ─────────────────────────
# Create a free account at https://alpaca.markets, then:
#   Home → switch to "Paper Trading" → API Keys → Generate
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET=

# ─── Alpaca: live trading (REAL money) ───────────────────────────────────────
# Leave blank until you have actually traded on paper for a while.
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET=

# ─── Which account every command talks to ────────────────────────────────────
# `paper` or `live`. ANY other value — unset, empty, misspelled — is treated as
# paper. Reaching real money is always a deliberate act.
ALPACA_MODE=paper


# ═════════════════════════════════════════════════════════════════════════════
# Everything below is OPTIONAL. toreda is fully functional without any of it.
# ═════════════════════════════════════════════════════════════════════════════

# ─── Telegram briefing delivery (optional) ───────────────────────────────────
# Only needed if you want briefings pushed to Telegram. `toreda brief` prints to
# your terminal with no configuration at all, and can also write to a file or
# raise a desktop notification instead. See docs/briefings.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Claude commentary in briefings (optional) ───────────────────────────────
# Lets scheduled briefings include written commentary instead of just the data
# table. Uses your Claude Code subscription, not API billing. Generate with:
#   claude setup-token
# Without it, briefings still send — they just carry the numbers alone.
CLAUDE_CODE_OAUTH_TOKEN=

# ─── Data directory (optional) ───────────────────────────────────────────────
# Where config, journal, and logs live. Defaults to this repo. Set it to keep
# your trading data outside the checkout entirely.
# TOREDA_HOME=
